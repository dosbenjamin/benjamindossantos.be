---
import { Font } from 'astro:assets';
import '#shared/styles/global.css';
import { seoPaths, siteMetadata } from '#shared/seo.ts';
import type { PersonStructuredData, RobotsDirective } from '#shared/seo.ts';
import { plausibleAnalytics } from '#shared/site.ts';

type Props = {
  canonical?: boolean;
  description: string;
  robots?: RobotsDirective;
  socialDescription?: string;
  structuredData?: PersonStructuredData;
  title: string;
}

const {
  canonical = true,
  description,
  robots = 'index,follow',
  socialDescription = description,
  structuredData,
  title,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const openGraphImageURL = new URL(
  seoPaths.openGraphImage,
  Astro.site ?? Astro.url.origin
);
---

<!doctype html>
<html lang={siteMetadata.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content={siteMetadata.author} />
    <meta name="robots" content={robots} />
    <link rel="preconnect" href={plausibleAnalytics.origin} />
    <link
      rel="icon"
      href="/favicon-light.svg"
      media="(prefers-color-scheme: light)"
      type="image/svg+xml"
    />
    <link
      rel="icon"
      href="/favicon-dark.svg"
      media="(prefers-color-scheme: dark)"
      type="image/svg+xml"
    />
    <link rel="apple-touch-icon" href={seoPaths.appleTouchIcon} sizes="180x180" />
    {canonical && <link rel="canonical" href={canonicalURL} />}
    <link rel="sitemap" href={seoPaths.sitemap} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteMetadata.siteName} />
    <meta property="og:locale" content={siteMetadata.locale} />
    <meta property="og:image" content={openGraphImageURL} />
    <meta property="og:image:type" content={siteMetadata.openGraphImageType} />
    <meta property="og:image:width" content={siteMetadata.openGraphImageWidth} />
    <meta property="og:image:height" content={siteMetadata.openGraphImageHeight} />
    <meta property="og:image:alt" content={siteMetadata.openGraphImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={openGraphImageURL} />
    <meta name="twitter:image:alt" content={siteMetadata.openGraphImageAlt} />
    {
      structuredData && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        />
      )
    }
    <script
      is:inline
      defer
      data-domain={plausibleAnalytics.domain}
      src={plausibleAnalytics.scriptURL}
    ></script>
    <script is:inline>
      window.plausible ||= function plausible(...args) {
        window.plausible.q ||= [];
        window.plausible.q.push(args);
      };
    </script>
    <Font cssVariable="--font-schibsted-grotesk-source" preload />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
