---
import NotFoundPage from '../features/errors/components/not-found-page.astro';
import BaseLayout from '../layouts/base-layout.astro';
import { siteIdentity } from '../shared/site';

const title = `Page not found — ${siteIdentity.name}`;
const description =
  `The requested page could not be found. Return to the ${siteIdentity.name} portfolio.`;
---

<BaseLayout canonical={false} {description} robots="noindex,follow" {title}>
  <NotFoundPage />
</BaseLayout>
