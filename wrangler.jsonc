{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "benjamindossantos",
  "compatibility_date": "2026-08-07",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "benjamindossantos.be",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
